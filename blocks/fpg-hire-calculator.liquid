{%- doc -%}
  FP&G hire planner for hire products. The shopper picks the first and last day
  of the hire; the block works out the cheapest mix of the product's Day, Extra
  Day, Weekend and Week variants, shows the price with VAT and books it into the
  basket with the dates attached. When the machine can't be booked online it
  shows a hire request form instead (sent to the shop through the contact form).
  Renders nothing for products without a "Day" variant, so it can sit on the
  standard product template too. Behaviour: assets/fpg-hire.js.

  @example
  {% content_for 'block', type: 'fpg-hire-calculator', id: 'fpg_hire_calc' %}
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  assign v_day = null
  assign v_extra = null
  assign v_week = null
  assign v_weekend = null
  for v in product.variants
    assign t = v.title | downcase | strip
    case t
      when 'day'
        assign v_day = v
      when 'extra day'
        assign v_extra = v
      when 'week'
        assign v_week = v
      when 'weekend'
        assign v_weekend = v
    endcase
  endfor
  assign vat_rate = settings.fpg_vat_rate | default: 20
-%}

{%- if v_day != blank -%}
  {{ 'fpg-hire.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'fpg-cart.js' | asset_url }}" type="module"></script>
  <script src="{{ 'fpg-hire.js' | asset_url }}" type="module"></script>

  <fpg-hire-calculator
    id="fpg-hire"
    class="fpg-hire-calc spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    data-vat-rate="{{ vat_rate }}"
    {% if block_settings.replace_buy_buttons %}
      data-replace
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <script type="application/json" data-rates>
      {
        "day": {"id": {{ v_day.id }}, "price": {{ v_day.price }}, "available": {{ v_day.available }}},
        "extra": {% if v_extra %}{"id": {{ v_extra.id }}, "price": {{ v_extra.price }}, "available": {{ v_extra.available }}}{% else %}null{% endif %},
        "week": {% if v_week %}{"id": {{ v_week.id }}, "price": {{ v_week.price }}, "available": {{ v_week.available }}}{% else %}null{% endif %},
        "weekend": {% if v_weekend %}{"id": {{ v_weekend.id }}, "price": {{ v_weekend.price }}, "available": {{ v_weekend.available }}}{% else %}null{% endif %}
      }
    </script>

    <p class="fpg-hire-calc__heading">{{ block_settings.heading | escape }}</p>

    <div class="fpg-hire-calc__quick" role="group" aria-label="Quick choices">
      <button type="button" data-quick="day">1 day</button>
      {%- if v_weekend -%}<button type="button" data-quick="weekend">A weekend</button>{%- endif -%}
      {%- if v_week -%}<button type="button" data-quick="week">1 week</button>{%- endif -%}
    </div>

    <div class="fpg-hire-calc__dates">
      <label>
        <span>First day</span>
        <input type="date" data-start required>
      </label>
      <label>
        <span>Last day</span>
        <input type="date" data-end required>
      </label>
    </div>

    <div class="fpg-hire-calc__result" data-result aria-live="polite">
      <p class="fpg-hire-calc__placeholder">Choose your dates to see the price.</p>
    </div>

    <div class="fpg-hire-calc__actions" data-book-area hidden>
      <button type="button" class="button fpg-hire-calc__book" data-book>Book this hire</button>
      <p class="fpg-hire-calc__message" data-message role="status"></p>
    </div>

    {%- if block_settings.show_request -%}
      {%- capture form_id -%}FpgHireRequest-{{ block.id }}{%- endcapture -%}
      <details class="fpg-hire-calc__request" data-request>
        <summary data-request-summary>Send us a hire request</summary>
        {%- form 'contact', id: form_id, class: 'fpg-hire-calc__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="fpg-hire-calc__sent" role="status">Thanks, we've got your request and will be in touch to confirm the hire.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="fpg-hire-calc__error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[Machine]" value="{{ product.title | escape }}">
          <input type="hidden" name="contact[Hire dates]" data-field-dates>
          <input type="hidden" name="contact[Estimate]" data-field-estimate>
          <div class="fpg-hire-calc__fields">
            <label><span>Name</span><input type="text" name="contact[name]" autocomplete="name" required></label>
            <label><span>Email</span><input type="email" name="contact[email]" autocomplete="email" required></label>
            <label><span>Phone</span><input type="tel" name="contact[Phone]" autocomplete="tel"></label>
            <label class="fpg-hire-calc__wide">
              <span>Anything else?</span>
              <textarea name="contact[body]" rows="3" placeholder="e.g. site location, how you'll collect"></textarea>
            </label>
          </div>
          <button type="submit" class="button button-secondary">Send hire request</button>
        {%- endform -%}
      </details>
    {%- endif -%}

    {%- if block_settings.note != blank -%}
      <div class="fpg-hire-calc__note">{{ block_settings.note }}</div>
    {%- endif -%}
  </fpg-hire-calculator>
{%- elsif request.design_mode -%}
  <p {{ block.shopify_attributes }}>The hire planner shows on products with Day, Extra Day, Week and Weekend variants.</p>
{%- endif -%}

{% stylesheet %}
  .product-details:has(.fpg-hire-calc[data-replace]) .buy-buttons-block {
    display: none;
  }

  body:has(.fpg-hire-calc[data-replace]) sticky-add-to-cart {
    display: none !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FP&G hire planner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Plan your hire" },
    {
      "type": "checkbox",
      "id": "replace_buy_buttons",
      "label": "Replace the Add to cart button",
      "info": "The planner books the right mix of day, weekend and week rates with the dates.",
      "default": true
    },
    { "type": "checkbox", "id": "show_request", "label": "Show the hire request form", "default": true },
    {
      "type": "richtext",
      "id": "note",
      "label": "Hire terms",
      "default": "<p>All prices are based on local collection. You will need hired-in plant insurance for the hire period. Delivery is available at cost on hire periods of more than one month.</p>"
    },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 8 }
  ],
  "presets": [
    { "name": "FP&G hire planner" }
  ]
}
{% endschema %}

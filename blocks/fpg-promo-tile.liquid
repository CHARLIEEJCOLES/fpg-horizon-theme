{%- doc -%}
  FP&G promo tile: an offer or message card placed inside the collection
  product grid, the same size as a product card. Rendered as a static block
  from sections/main-collection.liquid, which passes the position of the
  product about to be drawn; the tile appears just before the product at its
  chosen position (so position 5 makes it the 5th item on page 1).
  Leave "Collections" empty to show it on every collection.

  Content: "Matched to the collection" picks from the ad library in
  snippets/fpg-feed-ad.liquid (chain finder on saw collections, the kit
  builder on climbing, hire on chippers, and so on), rotating so the two tiles,
  later repeats and neighbouring collections show different ads. "My own
  content" uses the fields below. "Repeat every" places the tile again further
  down long collections, including pages loaded by infinite scroll.

  @param {number} fpg_position - Position (1-based, across pages) of the next product in the grid
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign show = false
  assign occurrence = 0
  assign start = block_settings.position
  assign every = block_settings.repeat_every | default: 0
  if block_settings.enabled
    if fpg_position == start
      assign show = true
    elsif every > 0 and fpg_position > start
      assign gap = fpg_position | minus: start
      assign rest = gap | modulo: every
      if rest == 0
        assign show = true
        assign occurrence = gap | divided_by: every
      endif
    endif
  endif
  if show
    if block_settings.collections != blank
      assign show = false
      for c in block_settings.collections
        if c.handle == collection.handle
          assign show = true
          break
        endif
      endfor
    endif
  endif

  assign tile_style = ''
  if block_settings.background_color != blank
    assign tile_style = tile_style | append: '--fpg-tile-bg: ' | append: block_settings.background_color | append: ';'
  endif
  if block_settings.text_color != blank
    assign tile_style = tile_style | append: '--fpg-tile-fg: ' | append: block_settings.text_color | append: ';'
  endif
-%}

{%- if show and block_settings.mode != 'custom' -%}
  {%- liquid
    capture pool_list
      render 'fpg-feed-ad', mode: 'pool'
    endcapture
    assign pool = pool_list | split: ','
    # Tile 1 and tile 2 take turns through the pool. Each collection starts at one of
    # its three most relevant ads, so neighbouring collections differ but the first
    # tiles stay on topic.
    assign tile_offset = 0
    if block.id contains 'promo-tile-2'
      assign tile_offset = 1
    endif
    assign slot = occurrence | times: 2 | plus: tile_offset
    assign start_range = pool.size | at_most: 3 | at_least: 1
    assign start_at = collection.id | modulo: start_range
    assign pick = slot | plus: start_at | modulo: pool.size
    assign ad_key = pool[pick]
    capture attrs
      echo block.shopify_attributes
    endcapture
  -%}
  {% render 'fpg-feed-ad', key: ad_key, attrs: attrs %}
{%- elsif show -%}
  <li class="product-grid__item fpg-promo-tile{% if block_settings.image != blank %} fpg-promo-tile--image{% endif %}" style="{{ tile_style }}" {{ block.shopify_attributes }}>
    {%- if block_settings.link != blank -%}
      <a class="fpg-promo-tile__link" href="{{ block_settings.link }}">
    {%- else -%}
      <div class="fpg-promo-tile__link">
    {%- endif -%}
      {%- if block_settings.image != blank -%}
        <span class="fpg-promo-tile__media">
          {{
            block_settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 990px) 25vw, 50vw',
              alt: ''
          }}
        </span>
      {%- endif -%}
      <span class="fpg-promo-tile__content">
        {%- if block_settings.eyebrow != blank -%}
          <span class="fpg-promo-tile__eyebrow">{{ block_settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if block_settings.heading != blank -%}
          <span class="fpg-promo-tile__heading">{{ block_settings.heading | escape }}</span>
        {%- endif -%}
        {%- if block_settings.text != blank -%}
          <span class="fpg-promo-tile__text">{{ block_settings.text | escape }}</span>
        {%- endif -%}
        {%- if block_settings.button_label != blank and block_settings.link != blank -%}
          <span class="fpg-promo-tile__cta">
            {{ block_settings.button_label | escape }}
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        {%- endif -%}
      </span>
    {%- if block_settings.link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  </li>
{%- endif -%}

{% schema %}
{
  "name": "FP&G promo tile",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show this tile",
      "default": false
    },
    {
      "type": "range",
      "id": "position",
      "label": "Position in the grid",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "repeat_every",
      "label": "Repeat every",
      "info": "Show the tile again after this many products, all the way down the collection. 0 shows it once.",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 18
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Content",
      "options": [
        { "value": "auto", "label": "Matched to the collection" },
        { "value": "custom", "label": "My own content" }
      ],
      "default": "auto",
      "info": "Matched ads rotate through the FP&G ad set (parts finder, servicing, hire, kit builder, training and more), picked for each collection."
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Only on these collections",
      "info": "Leave empty to show on every collection."
    },
    {
      "type": "image_picker",
      "id": "image",
      "visible_if": "{{ block.settings.mode == 'custom' }}",
      "label": "Image",
      "info": "Optional. Text sits on a dark overlay when an image is used."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "visible_if": "{{ block.settings.mode == 'custom' }}",
      "label": "Small heading"
    },
    {
      "type": "text",
      "id": "heading",
      "visible_if": "{{ block.settings.mode == 'custom' }}",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "visible_if": "{{ block.settings.mode == 'custom' }}",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "visible_if": "{{ block.settings.mode == 'custom' }}",
      "label": "Link label",
      "default": "Find out more"
    },
    {
      "type": "url",
      "id": "link",
      "visible_if": "{{ block.settings.mode == 'custom' }}",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "visible_if": "{{ block.settings.mode == 'custom' }}",
      "label": "Background colour",
      "default": "#002D37"
    },
    {
      "type": "color",
      "id": "text_color",
      "visible_if": "{{ block.settings.mode == 'custom' }}",
      "label": "Text colour",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}

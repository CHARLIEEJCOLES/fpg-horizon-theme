    { "type": "text", "id": "hours_thu", "label": "Thursday hours", "default": "8:00AM - 5:00PM" },
    { "type": "text", "id": "name_fri", "label": "Friday label", "default": "Fri" },
    { "type": "text", "id": "hours_fri", "label": "Friday hours", "default": "8:00AM - 5:00PM" },

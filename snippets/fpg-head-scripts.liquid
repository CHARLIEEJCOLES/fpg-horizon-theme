{%- doc -%}
  FP&G scripts for the page head, controlled from Theme settings > FP&G:
  - the FP&G design layer (assets/fpg-design.css and assets/fpg-design.js) on every page
  - the header and menu styling (assets/fpg-menu.css) and the round 3 look
    (assets/fpg-look.css and assets/fpg-look.js) and round 4 (assets/fpg-boost.css).
    Round 5's assets/fpg-fit.css is loaded only by the four things that use it
    (fpg-fit-finder, fpg-help-panel, fpg-fits, fpg-complete-job).
  - business details (Store structured data) on the home and contact pages
  - jQuery 3.7.1 for the FPG Part Finder app (the same file the current theme
    loads), only on the Part Finder page template (or site-wide if ticked)
  - an optional GA4 tag. Leave the GA4 ID blank when the Google & YouTube app
    is installed, otherwise visits are counted twice.
  Rendered from layout/theme.liquid.

  @example
  {% render 'fpg-head-scripts' %}
{%- enddoc -%}

{%- liquid
  assign load_jquery = false
  if settings.fpg_jquery_everywhere
    assign load_jquery = true
  elsif settings.fpg_part_finder_template != blank and template.suffix == settings.fpg_part_finder_template
    assign load_jquery = true
  endif
-%}

{{ 'fpg-design.css' | asset_url | stylesheet_tag }}
{{ 'fpg-menu.css' | asset_url | stylesheet_tag }}
{{ 'fpg-look.css' | asset_url | stylesheet_tag }}
{{ 'fpg-boost.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fpg-design.js' | asset_url }}" type="module"></script>
<script src="{{ 'fpg-look.js' | asset_url }}" type="module"></script>

{%- if load_jquery -%}
  <script
    src="https://code.jquery.com/jquery-3.7.1.min.js"
    integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
    crossorigin="anonymous"
    defer
  ></script>
{%- endif -%}

{%- comment -%}
  Business details for search engines (Google's local results and knowledge
  panel): on the home and contact pages only.
{%- endcomment -%}
{%- if request.page_type == 'index' or page.handle == 'contact' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Store",
      "@id": {{ request.origin | append: '/#store' | json }},
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      {%- if settings.logo != blank %}
      "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      "image": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- endif %}
      "telephone": "+44 1443 230000",
      "email": "sales@fpandg.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Coed Court, Treforest Industrial Estate",
        "addressLocality": "Pontypridd",
        "addressRegion": "Rhondda Cynon Taf",
        "postalCode": "CF37 5SW",
        "addressCountry": "GB"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "08:00",
          "closes": "17:00"
        }
      ],
      "sameAs": [
        "https://www.facebook.com/forestparkandgarden",
        "https://www.instagram.com/forestparkgarden",
        "https://www.youtube.com/channel/UCr5dTuiDN2TnXuPl0UGb2iA",
        "https://twitter.com/forestparkgarde"
      ]
    }
  </script>
{%- endif -%}

{%- if settings.fpg_ga4_id != blank -%}
  {%- assign ga4_id = settings.fpg_ga4_id | strip -%}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga4_id | url_encode }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', {{ ga4_id | json }});
  </script>
{%- endif -%}

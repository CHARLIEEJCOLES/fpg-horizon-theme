{%- comment -%}
  FP&G "How can we help?" cards. Each card has a line icon, a title, a short
  line and a link. Five across on wide screens; on tablets and phones the cards
  turn into icon-left rows so the text has room. Styles: assets/fpg-look.css.
{%- endcomment -%}

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style fpg-help{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <header class="fpg-help__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fpg-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </header>

  <ul class="fpg-help__grid" role="list" style="--fpg-help-count: {{ section.blocks.size }};">
    {%- for block in section.blocks -%}
      <li class="fpg-help__item" {{ block.shopify_attributes }}>
        <a class="fpg-help__card" href="{{ block.settings.link | default: '#' }}">
          <span class="fpg-help__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'part' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/></svg>
              {%- when 'chain' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
              {%- when 'service' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0 5 5L21 13l-8 8-3-3 1.3-1.3a4 4 0 0 0-5-5L3 10l3-3 1.3 1.3"/><path d="m9 15 6-6"/></svg>
              {%- when 'hire' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16V7h11v9M13 10h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="2"/><circle cx="16.5" cy="17.5" r="2"/></svg>
              {%- when 'kit' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6a3 3 0 0 1 3 3v3a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Z"/><path d="M12 12v4"/><rect x="8" y="16" width="8" height="5" rx="2.5"/></svg>
              {%- when 'phone' -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
              {%- else -%}
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
            {%- endcase -%}
          </span>
          <span class="fpg-help__body">
            <span class="fpg-help__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.text != blank -%}
              <span class="fpg-help__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </span>
          <span class="fpg-help__go" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M4.5 10h11M15.5 10l-5-5M15.5 10l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "FP&G help cards",
  "tag": "section",
  "class": "fpg-help-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Parts · Servicing · Hire · Kit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How can we help?" },
    { "type": "color", "id": "background_color", "label": "Background colour" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "part", "label": "Part" },
            { "value": "chain", "label": "Chain link" },
            { "value": "service", "label": "Spanner" },
            { "value": "hire", "label": "Truck" },
            { "value": "kit", "label": "Harness" },
            { "value": "phone", "label": "Phone" },
            { "value": "search", "label": "Search" }
          ],
          "default": "part"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Find a part" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "FP&G help cards" }]
}
{% endschema %}

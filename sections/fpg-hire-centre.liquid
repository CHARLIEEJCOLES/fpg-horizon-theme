{%- comment -%}
  FP&G hire centre: the landing page for the hire collection. Explains how
  hire works, lists every machine in the collection with its day, weekend and
  week rates and whether it can be booked online, and links to each machine's
  hire planner (blocks/fpg-hire-calculator.liquid). Uses the page's collection
  unless one is chosen.
{%- endcomment -%}

{{ 'fpg-hire.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign source = section.settings.collection | default: collection
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width spacing-style fpg-hirec{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="fpg-hirec__inner">
    <header class="fpg-hirec__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fpg-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fpg-hirec__title h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="fpg-hirec__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <ol class="fpg-hirec__steps">
      {%- for i in (1..3) -%}
        {%- assign t_key = 'step_' | append: i | append: '_title' -%}
        {%- assign x_key = 'step_' | append: i | append: '_text' -%}
        {%- if section.settings[t_key] != blank -%}
          <li>
            <strong>{{ section.settings[t_key] | escape }}</strong>
            <span>{{ section.settings[x_key] | escape }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>

    {%- if source != blank -%}
      <ul class="fpg-hirec__grid" id="hire-machines" role="list">
        {%- for product in source.products limit: 24 -%}
          {%- liquid
            assign r_day = null
            assign r_week = null
            assign r_weekend = null
            assign online = false
            for v in product.variants
              assign t = v.title | downcase | strip
              if t == 'day'
                assign r_day = v
                if v.available
                  assign online = true
                endif
              elsif t == 'week'
                assign r_week = v
              elsif t == 'weekend'
                assign r_weekend = v
              endif
            endfor
            assign name = product.title | remove_first: 'FPG HIRE' | remove_first: 'Hire' | strip
          -%}
          <li class="fpg-hirec__card">
            <a class="fpg-hirec__media" href="{{ product.url }}#fpg-hire" tabindex="-1" aria-hidden="true">
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 640
                  | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 990px) 33vw, 90vw', alt: ''
                }}
              {%- endif -%}
            </a>
            <div class="fpg-hirec__body">
              <h3 class="fpg-hirec__name h5"><a href="{{ product.url }}#fpg-hire">{{ name | escape }}</a></h3>
              {%- if r_day -%}
                <p class="fpg-hirec__from">From <strong>{{ r_day.price | money }}</strong> a day + VAT</p>
              {%- endif -%}
              <dl class="fpg-hirec__rates">
                {%- if r_day -%}<div><dt>Day</dt><dd>{{ r_day.price | money_without_trailing_zeros }}</dd></div>{%- endif -%}
                {%- if r_weekend -%}<div><dt>Weekend</dt><dd>{{ r_weekend.price | money_without_trailing_zeros }}</dd></div>{%- endif -%}
                {%- if r_week -%}<div><dt>Week</dt><dd>{{ r_week.price | money_without_trailing_zeros }}</dd></div>{%- endif -%}
              </dl>
              {%- if online -%}
                <p class="fpg-hirec__status fpg-hirec__status--online">✓ Book online</p>
              {%- else -%}
                <p class="fpg-hirec__status">Send a hire request</p>
              {%- endif -%}
              <a class="button" href="{{ product.url }}#fpg-hire">Choose dates</a>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.info != blank or section.settings.info_2 != blank -%}
      <div class="fpg-hirec__info">
        {%- if section.settings.info != blank -%}
          <div>
            <h3 class="h4">{{ section.settings.info_heading | escape }}</h3>
            {{ section.settings.info }}
          </div>
        {%- endif -%}
        {%- if section.settings.info_2 != blank -%}
          <div>
            <h3 class="h4">{{ section.settings.info_2_heading | escape }}</h3>
            {{ section.settings.info_2 }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FP&G hire centre",
  "tag": "section",
  "class": "fpg-hirec-section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Hire collection", "info": "Leave blank on a collection page to use that collection." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Machine hire" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hire professional machinery from Treforest" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Chippers, stump grinders, brush cutters and mowers, maintained by our own workshop. Pick a machine, choose your dates and see the price straight away.</p>"
    },
    { "type": "text", "id": "step_1_title", "label": "Step 1", "default": "Choose your machine and dates" },
    { "type": "text", "id": "step_1_text", "label": "Step 1 text", "default": "The planner finds the best mix of day, weekend and week rates." },
    { "type": "text", "id": "step_2_title", "label": "Step 2", "default": "Book or send a request" },
    { "type": "text", "id": "step_2_text", "label": "Step 2 text", "default": "Book online where you can, or send us a request and we'll confirm availability." },
    { "type": "text", "id": "step_3_title", "label": "Step 3", "default": "Collect from Coed Court" },
    { "type": "text", "id": "step_3_text", "label": "Step 3 text", "default": "Pick the machine up from our Treforest yard and bring it back when you're done." },
    { "type": "text", "id": "info_heading", "label": "Info heading", "default": "Good to know" },
    {
      "type": "richtext",
      "id": "info",
      "label": "Info",
      "default": "<ul><li>All prices are based on local collection.</li><li>You will need hired-in plant insurance for the hire period.</li><li>Delivery is available at cost on hire periods of more than one month.</li></ul>"
    },
    { "type": "text", "id": "info_2_heading", "label": "Second info heading", "default": "Need help choosing?" },
    {
      "type": "richtext",
      "id": "info_2",
      "label": "Second info",
      "default": "<p>Call us on <a href=\"tel:01443230000\">01443 230000</a> and we'll help you pick the right machine for the job.</p>"
    },
    { "type": "color", "id": "background_color", "label": "Background colour" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [
    { "name": "FP&G hire centre" }
  ]
}
{% endschema %}

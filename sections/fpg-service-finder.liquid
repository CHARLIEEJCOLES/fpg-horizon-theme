{%- comment -%}
  FP&G service finder. Shoppers pick the machine type and brand, see the
  matching service with its price, choose a category where there is one, add
  their machine's model and any notes, and book it straight into the basket
  (the details go with the order as line item properties). Each "Service"
  block links one service product to a machine type and brand.
  Behaviour: assets/fpg-service-finder.js.
{%- endcomment -%}

{{ 'fpg-service-finder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fpg-cart.js' | asset_url }}" type="module"></script>
<script src="{{ 'fpg-service-finder.js' | asset_url }}" type="module"></script>

{%- liquid
  assign vat_rate = settings.fpg_vat_rate | default: 20
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<fpg-service-finder
  class="section section--page-width spacing-style fpg-svc{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
  data-vat-rate="{{ vat_rate }}"
>
  <script type="application/json" data-services>
    [
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          {
            "block": {{ block.id | json }},
            "machine": {{ block.settings.machine | strip | json }},
            "brand": {{ block.settings.brand | strip | json }},
            "productId": {{ p.id }},
            "title": {{ p.title | json }},
            "url": {{ p.url | json }},
            "image": {% if p.featured_image %}{{ p.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %},
            "option": {{ p.options.first | json }},
            "variants": [{%- for v in p.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"price":{{ v.price }},"available":{{ v.available }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}],
            "guides": [{%- for image in p.images offset: 1 -%}{{ image | image_url: width: 1200 | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
          }{% unless forloop.last %},{% endunless %}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>

  <div class="fpg-svc__inner">
    <header class="fpg-svc__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fpg-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="fpg-svc__title h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.intro != blank -%}
        <div class="fpg-svc__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <div class="fpg-svc__layout">
      <div class="fpg-svc__tool">
        <fieldset class="fpg-svc__step">
          <legend class="fpg-svc__legend"><span aria-hidden="true">1</span> What needs a service?</legend>
          <div class="fpg-svc__choices" data-machines></div>
        </fieldset>

        <fieldset class="fpg-svc__step" data-brand-step hidden>
          <legend class="fpg-svc__legend"><span aria-hidden="true">2</span> Which brand is it?</legend>
          <div class="fpg-svc__choices" data-brands></div>
        </fieldset>

        <div class="fpg-svc__step fpg-svc__result" data-result hidden aria-live="polite">
          <p class="fpg-svc__legend"><span aria-hidden="true">3</span> Your service</p>
          <div class="fpg-svc__card">
            <div class="fpg-svc__card-media" data-result-image></div>
            <div class="fpg-svc__card-body">
              <h3 class="fpg-svc__card-title h4" data-result-title></h3>
              <p class="fpg-svc__card-price" data-result-price></p>
              <div class="fpg-svc__variants" data-variants hidden></div>
              <details class="fpg-svc__guide" data-guide hidden>
                <summary>Which category is my machine?</summary>
                <div class="fpg-svc__guide-images" data-guide-images></div>
              </details>
            </div>
          </div>

          <form class="fpg-svc__form" data-form novalidate>
            <div class="fpg-svc__fields">
              <label class="fpg-svc__field">
                <span>Machine model <abbr title="required">*</abbr></span>
                <input type="text" name="model" required maxlength="80" autocomplete="off" placeholder="e.g. MS 261 C-M">
              </label>
              <label class="fpg-svc__field">
                <span>Serial number (optional)</span>
                <input type="text" name="serial" maxlength="40" autocomplete="off">
              </label>
              <label class="fpg-svc__field fpg-svc__field--wide">
                <span>Anything we should know? (optional)</span>
                <textarea name="notes" rows="3" maxlength="400" placeholder="e.g. hard to start, chain brake sticking"></textarea>
              </label>
            </div>
            <p class="fpg-svc__error" data-error role="alert" hidden></p>
            <button type="submit" class="button fpg-svc__book" data-book>Book this service</button>
            <p class="fpg-svc__message" data-message role="status"></p>
          </form>
        </div>

        <noscript>
          <ul class="fpg-svc__fallback">
            {%- for block in section.blocks -%}
              {%- if block.settings.product != blank -%}
                <li><a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </noscript>
      </div>

      <aside class="fpg-svc__aside">
        {%- if section.settings.included != blank -%}
          <div class="fpg-svc__panel">
            <h3 class="fpg-svc__panel-title h5">{{ section.settings.included_heading | escape }}</h3>
            <div class="fpg-svc__ticks">{{ section.settings.included }}</div>
          </div>
        {%- endif -%}
        <div class="fpg-svc__panel">
          <h3 class="fpg-svc__panel-title h5">{{ section.settings.steps_heading | escape }}</h3>
          <ol class="fpg-svc__how">
            {%- for i in (1..3) -%}
              {%- assign t_key = 'step_' | append: i | append: '_title' -%}
              {%- assign x_key = 'step_' | append: i | append: '_text' -%}
              {%- if section.settings[t_key] != blank -%}
                <li>
                  <strong>{{ section.settings[t_key] | escape }}</strong>
                  {%- if section.settings[x_key] != blank -%}
                    <span>{{ section.settings[x_key] | escape }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        </div>
        {%- if section.settings.help != blank -%}
          <div class="fpg-svc__help">{{ section.settings.help }}</div>
        {%- endif -%}
      </aside>
    </div>
  </div>
</fpg-service-finder>

{% schema %}
{
  "name": "FP&G service finder",
  "tag": "section",
  "class": "fpg-svc-section",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Book a service" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find and book your service" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Tell us what needs looking at and we'll show you the service and price. Book online and we'll take it from there.</p>"
    },
    { "type": "text", "id": "included_heading", "label": "Included heading", "default": "One simple price includes" },
    {
      "type": "richtext",
      "id": "included",
      "label": "What's included",
      "default": "<ul><li>Genuine replacement parts</li><li>Speedy completion</li><li>Delivery and return included</li></ul>"
    },
    { "type": "text", "id": "steps_heading", "label": "Steps heading", "default": "How it works" },
    { "type": "text", "id": "step_1_title", "label": "Step 1", "default": "Book online" },
    { "type": "text", "id": "step_1_text", "label": "Step 1 text", "default": "Choose your service and tell us about your machine." },
    { "type": "text", "id": "step_2_title", "label": "Step 2", "default": "Send it to us" },
    {
      "type": "text",
      "id": "step_2_text",
      "label": "Step 2 text",
      "default": "We email you an Evri delivery label. Print it, package the machine and drop it at any Evri location."
    },
    { "type": "text", "id": "step_3_title", "label": "Step 3", "default": "Serviced and returned" },
    { "type": "text", "id": "step_3_text", "label": "Step 3 text", "default": "Our mechanics service it and send it back to you." },
    {
      "type": "richtext",
      "id": "help",
      "label": "Help text",
      "default": "<p>Machine not listed or need a repair? Call the workshop on <a href=\"tel:01443230000\">01443 230000</a>.</p>"
    },
    { "type": "color", "id": "background_color", "label": "Background colour" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "product", "id": "product", "label": "Service product" },
        { "type": "text", "id": "machine", "label": "Machine type", "info": "Services with the same machine type are grouped, e.g. Chainsaw.", "default": "Chainsaw" },
        { "type": "text", "id": "brand", "label": "Brand", "default": "STIHL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FP&G service finder"
    }
  ]
}
{% endschema %}

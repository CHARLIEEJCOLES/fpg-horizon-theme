{%- comment -%}
  FP&G "My machines": the customer's machines with one-tap links to order
  parts and book a service. Signed in, the list is the customer metafield
  fpg.machines (saved through the FPG Part Finder app's proxy) plus machines
  bought from FP&G (from Polly, through the same app). Signed out, it's kept
  in the browser. Behaviour: assets/fpg-my-machines.js.
  Back-end set-up: fpg-tools/my-machines/APP-AND-POLLY.md.
{%- endcomment -%}

<script src="{{ 'fpg-parts.js' | asset_url }}" type="module"></script>
<script src="{{ 'fpg-my-machines.js' | asset_url }}" type="module"></script>

{%- liquid
  assign proxy = '/' | append: section.settings.proxy_prefix | append: '/' | append: section.settings.proxy_subpath
  assign login_url = routes.account_login_url | append: '?return_url=' | append: request.path
  assign quick = section.settings.quick_add | split: ','
-%}

<div class="section-background fpg-mm-bg"></div>
<div
  class="section section--page-width spacing-style fpg-mm-section"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <fpg-my-machines
    class="fpg-mm"
    data-signed-in="{% if customer %}true{% else %}false{% endif %}"
    data-proxy="{{ proxy | escape }}"
    data-index="{{ 'fpg-parts-index.json' | asset_url }}"
    data-parts-script="{{ 'fpg-parts.js' | asset_url }}"
    data-finder-url="{{ section.settings.finder_url | default: '/pages/fpg-part-finder' }}"
    data-service-url="{{ section.settings.service_url | default: '/collections/servicing-repair' }}"
    data-contact-url="{{ section.settings.contact_url | default: '/pages/contact' }}"
    data-search-url="{{ routes.search_url }}"
  >
    {%- if customer -%}
      <script type="application/json" data-account-machines>
        {%- if customer.metafields.fpg.machines.value != blank -%}
          {{ customer.metafields.fpg.machines.value | json }}
        {%- else -%}
          []
        {%- endif -%}
      </script>
    {%- endif -%}

    <header class="fpg-mm__hero">
      <p class="fpg-mm__eyebrow">{{ section.settings.kicker | escape }}</p>
      <h1 class="fpg-mm__title">
        {%- if customer and customer.first_name != blank -%}
          {{ customer.first_name | escape }}'s machines.
        {%- else -%}
          {{ section.settings.heading | escape }}
        {%- endif -%}
      </h1>
      <p class="fpg-mm__lede">{{ section.settings.text | escape }}</p>

      <div class="fpg-mm__add" data-addbox>
        <label class="visually-hidden" for="FpgMmAdd-{{ section.id }}">Add a machine by its model</label>
        <div class="fpg-mm__field">
          <svg class="fpg-mm__field-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input
            id="FpgMmAdd-{{ section.id }}"
            type="search"
            placeholder="Add a machine: type its model, e.g. MS 261"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="done"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="FpgMmList-{{ section.id }}"
            data-add-search
          >
          <ul class="fpg-mm__panel" id="FpgMmList-{{ section.id }}" role="listbox" aria-label="Matching machines" data-add-suggest hidden></ul>
        </div>
        <p class="fpg-mm__hint">The model is printed on the machine's label, usually by the handle or on the engine cover.</p>
        {%- if quick.size > 0 -%}
          <div class="fpg-mm__quick" data-quick>
            <span>Quick add</span>
            {%- for q in quick -%}
              {%- assign q_clean = q | strip -%}
              {%- if q_clean != blank -%}
                <button type="button" class="fpg-mm__chip" data-quick-add="{{ q_clean | escape }}">{{ q_clean | escape }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </header>

    {%- unless customer -%}
      <aside class="fpg-mm__signin">
        <div class="fpg-mm__signin-text">
          <strong>Keep them on your account.</strong>
          <span>Sign in to see your machines on any device, including the ones you've bought from us.</span>
        </div>
        <a class="fpg-mm__btn fpg-mm__btn--primary" href="{{ login_url }}">Sign in</a>
      </aside>
    {%- endunless -%}

    <p class="fpg-mm__status" data-status hidden></p>

    <ul class="fpg-mm__grid" role="list" data-list>
      <li class="fpg-mm__card fpg-mm__card--ghost" aria-hidden="true"><div class="fpg-mm__stage"></div><div class="fpg-mm__body"><span></span><span></span></div></li>
      <li class="fpg-mm__card fpg-mm__card--ghost" aria-hidden="true"><div class="fpg-mm__stage"></div><div class="fpg-mm__body"><span></span><span></span></div></li>
    </ul>

    <noscript><p class="fpg-mm__hint">Turn on JavaScript to add and manage your machines.</p></noscript>

    <div class="fpg-mm__toast" role="status" aria-live="polite" data-toast hidden></div>
  </fpg-my-machines>
</div>

{% stylesheet %}
  .fpg-mm-bg {
    background: linear-gradient(180deg, #f4f6f5 0%, #fbfcfb 420px, #fff 100%);
  }

  .fpg-mm {
    --mm-ink: var(--fpg-teal, #002d37);
    --mm-text: #1d2a2e;
    --mm-muted: rgb(29 42 46 / 0.62);
    --mm-line: rgb(0 45 55 / 0.1);
    --mm-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    display: grid;
    gap: clamp(20px, 3vw, 32px);
    max-width: 1120px;
    margin-inline: auto;
    color: var(--mm-text);
    -webkit-font-smoothing: antialiased;
  }

  .fpg-mm [hidden] {
    display: none !important;
  }

  /* ---------- hero ---------- */
  .fpg-mm__hero {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding-block: clamp(8px, 3vw, 32px) 4px;
    text-align: center;
  }

  .fpg-mm__eyebrow {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--fpg-sage, #5f7d6d);
  }

  .fpg-mm__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4rem);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -0.025em;
    color: var(--mm-ink);
  }

  .fpg-mm__lede {
    max-width: 34rem;
    margin: 0;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.45;
    color: var(--mm-muted);
  }

  /* ---------- add a machine ---------- */
  .fpg-mm__add {
    display: grid;
    gap: 10px;
    width: min(100%, 620px);
    margin-top: 12px;
  }

  .fpg-mm__field {
    position: relative;
  }

  .fpg-mm__field-icon {
    position: absolute;
    inset-inline-start: 22px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--mm-muted);
    pointer-events: none;
  }

  .fpg-mm__field input {
    width: 100%;
    height: 64px;
    padding: 0 24px 0 56px;
    border: 1px solid var(--mm-line);
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 45 55 / 0.04), 0 8px 28px rgb(0 45 55 / 0.08);
    font: inherit;
    font-size: 1.0625rem;
    color: var(--mm-text);
    transition: box-shadow 0.25s var(--mm-ease), border-color 0.25s;
    -webkit-appearance: none;
  }

  .fpg-mm__field input::placeholder {
    color: rgb(29 42 46 / 0.45);
  }

  .fpg-mm__field input:focus {
    outline: none;
    border-color: rgb(95 125 109 / 0.6);
    box-shadow: 0 0 0 4px rgb(95 125 109 / 0.16), 0 8px 28px rgb(0 45 55 / 0.1);
  }

  .fpg-mm__panel {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 10px);
    z-index: 10;
    margin: 0;
    padding: 8px;
    list-style: none;
    border: 1px solid var(--mm-line);
    border-radius: 22px;
    background: rgb(255 255 255 / 0.98);
    backdrop-filter: blur(20px);
    box-shadow: 0 24px 60px rgb(0 45 55 / 0.16);
    text-align: start;
    animation: fpg-mm-pop 0.18s var(--mm-ease);
  }

  .fpg-mm__panel button {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 56px;
    padding: 8px 12px;
    border: 0;
    border-radius: 14px;
    background: none;
    font: inherit;
    color: var(--mm-text);
    text-align: start;
    cursor: pointer;
  }

  .fpg-mm__panel [aria-selected='true'] button,
  .fpg-mm__panel button:hover {
    background: #f1f4f2;
  }

  .fpg-mm__opt-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #f1f4f2;
    color: var(--mm-ink);
  }

  .fpg-mm__opt-text {
    display: grid;
    gap: 1px;
  }

  .fpg-mm__opt-text strong {
    font-weight: 600;
    color: var(--mm-ink);
  }

  .fpg-mm__opt-text small {
    font-size: 0.8125rem;
    color: var(--mm-muted);
  }

  .fpg-mm__opt-add {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--mm-ink);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fpg-mm__none {
    padding: 14px 12px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--mm-muted);
  }

  .fpg-mm__none a,
  .fpg-mm__hint a {
    color: var(--mm-ink);
  }

  .fpg-mm__hint {
    margin: 0;
    font-size: 0.875rem;
    color: var(--mm-muted);
  }

  .fpg-mm__quick {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-size: 0.8125rem;
    color: var(--mm-muted);
  }

  .fpg-mm__chip {
    min-height: 36px;
    padding: 6px 14px;
    border: 1px solid var(--mm-line);
    border-radius: 999px;
    background: #fff;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--mm-ink);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .fpg-mm__chip:hover {
    border-color: var(--mm-ink);
  }

  /* ---------- sign in ---------- */
  .fpg-mm__signin {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    padding: 18px 22px;
    border: 1px solid var(--mm-line);
    border-radius: 20px;
    background: #fff;
  }

  .fpg-mm__signin-text {
    display: grid;
    gap: 2px;
    line-height: 1.4;
  }

  .fpg-mm__signin-text strong {
    color: var(--mm-ink);
  }

  .fpg-mm__signin-text span {
    color: var(--mm-muted);
    font-size: 0.9375rem;
  }

  .fpg-mm__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.875rem;
    color: var(--mm-muted);
  }

  .fpg-mm__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #c9a23a;
  }

  .fpg-mm__dot.is-synced {
    background: #2f9e5b;
  }

  /* ---------- machines ---------- */
  .fpg-mm__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(14px, 2vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fpg-mm__card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 45 55 / 0.05), 0 12px 32px rgb(0 45 55 / 0.07);
    transition: transform 0.35s var(--mm-ease), box-shadow 0.35s var(--mm-ease);
  }

  @media (hover: hover) {
    .fpg-mm__card:not(.fpg-mm__card--ghost):hover {
      transform: translateY(-3px);
      box-shadow: 0 2px 4px rgb(0 45 55 / 0.05), 0 22px 48px rgb(0 45 55 / 0.12);
    }
  }

  .fpg-mm__card.is-new {
    animation: fpg-mm-in 0.6s var(--mm-ease);
  }

  .fpg-mm__stage {
    display: grid;
    place-items: center;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    box-sizing: border-box;
    height: 210px;
    padding: 22px;
    overflow: hidden;
    background: radial-gradient(120% 90% at 50% 100%, #e7eeea 0%, #f5f7f6 55%, #fbfcfb 100%);
    color: var(--mm-ink);
  }

  .fpg-mm__stage > * {
    grid-area: 1 / 1;
  }

  .fpg-mm__stage svg {
    opacity: 0.85;
  }

  .fpg-mm__stage.has-photo svg {
    display: none;
  }

  .fpg-mm__stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    animation: fpg-mm-fade 0.4s ease;
  }

  .fpg-mm__x {
    position: absolute;
    top: 14px;
    inset-inline-end: 14px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(8px);
    color: var(--mm-muted);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, background-color 0.2s, color 0.2s;
  }

  .fpg-mm__card:hover .fpg-mm__x,
  .fpg-mm__x:focus-visible {
    opacity: 1;
  }

  @media (hover: none) {
    .fpg-mm__x {
      opacity: 1;
    }
  }

  .fpg-mm__x:hover {
    background: #fff;
    color: #b42318;
  }

  .fpg-mm__body {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 22px 24px 6px;
  }

  .fpg-mm__brand {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fpg-sage, #5f7d6d);
  }

  .fpg-mm__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.625rem, 1.3rem + 1vw, 2rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--mm-ink);
  }

  .fpg-mm__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 8px 0 0;
    font-size: 0.8125rem;
    color: var(--mm-muted);
  }

  .fpg-mm__badge {
    padding: 3px 10px;
    border-radius: 999px;
    background: #e8f3ec;
    color: #24734a;
    font-weight: 600;
  }

  .fpg-mm__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 18px 24px 24px;
  }

  .fpg-mm__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 10px 18px;
    border: 1px solid var(--mm-line);
    border-radius: 999px;
    background: #f1f4f2;
    color: var(--mm-ink) !important;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s, transform 0.15s;
  }

  .fpg-mm__btn:hover {
    background: #e6ebe8;
  }

  .fpg-mm__btn:active {
    transform: scale(0.98);
  }

  .fpg-mm__btn--primary {
    border-color: var(--mm-ink);
    background: var(--mm-ink);
    color: #fff !important;
  }

  .fpg-mm__btn--primary:hover {
    background: var(--fpg-teal-2, #0b3c47);
  }

  /* ---------- empty + loading ---------- */
  .fpg-mm__empty {
    display: grid;
    justify-items: center;
    gap: 10px;
    grid-column: 1 / -1;
    padding: clamp(32px, 6vw, 64px) 24px;
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 45 55 / 0.05), 0 12px 32px rgb(0 45 55 / 0.06);
    text-align: center;
  }

  .fpg-mm__empty-art {
    display: flex;
    gap: 14px;
    margin-bottom: 6px;
    color: rgb(0 45 55 / 0.35);
  }

  .fpg-mm__empty-art svg {
    padding: 14px;
    border-radius: 20px;
    background: #f1f4f2;
    width: 72px;
    height: 72px;
  }

  .fpg-mm__empty h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    color: var(--mm-ink);
  }

  .fpg-mm__empty p {
    max-width: 26rem;
    margin: 0;
    line-height: 1.45;
    color: var(--mm-muted);
  }

  .fpg-mm__card--ghost .fpg-mm__stage,
  .fpg-mm__card--ghost .fpg-mm__body span {
    background: linear-gradient(90deg, #eef2f0 25%, #f6f8f7 50%, #eef2f0 75%) 0 0 / 200% 100%;
    animation: fpg-mm-shimmer 1.3s linear infinite;
  }

  .fpg-mm__card--ghost .fpg-mm__body {
    padding-bottom: 28px;
  }

  .fpg-mm__card--ghost .fpg-mm__body span {
    display: block;
    height: 14px;
    width: 40%;
    border-radius: 6px;
  }

  .fpg-mm__card--ghost .fpg-mm__body span + span {
    height: 26px;
    width: 70%;
  }

  fpg-my-machines[data-ready] .fpg-mm__card--ghost {
    display: none;
  }

  /* ---------- toast ---------- */
  .fpg-mm__toast {
    position: fixed;
    left: 50%;
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: calc(100vw - 32px);
    padding: 12px 14px 12px 20px;
    border-radius: 999px;
    background: rgb(20 30 33 / 0.94);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: 0.9375rem;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.25);
    transform: translate(-50%, 20px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--mm-ease), transform 0.25s var(--mm-ease);
  }

  .fpg-mm__toast.is-on {
    transform: translate(-50%, 0);
    opacity: 1;
    pointer-events: auto;
  }

  .fpg-mm__toast button {
    min-height: 36px;
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #141e21;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  @keyframes fpg-mm-in {
    from {
      transform: scale(0.96);
      box-shadow: 0 0 0 3px rgb(95 125 109 / 0.5);
    }
  }

  @keyframes fpg-mm-pop {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }

  @keyframes fpg-mm-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes fpg-mm-shimmer {
    to {
      background-position: -200% 0;
    }
  }

  @media (max-width: 480px) {
    .fpg-mm__actions {
      grid-template-columns: 1fr;
    }

    .fpg-mm__stage {
      height: 170px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fpg-mm *,
    .fpg-mm *::before {
      animation: none !important;
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FP&G my machines",
  "tag": "section",
  "class": "fpg-mm-wrap",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above the heading", "default": "My machines" },
    { "type": "text", "id": "heading", "label": "Heading (signed out)", "default": "Your machines. Sorted." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Keep your machines in one place, with the right parts and servicing a tap away." },
    { "type": "text", "id": "quick_add", "label": "Quick add models", "info": "Comma separated, brand and model as listed in the parts finder. Shown until the first machine is added.", "default": "STIHL MS 261, STIHL MS 181, STIHL FS 94, Husqvarna 135" },
    { "type": "text", "id": "finder_url", "label": "Parts finder page", "default": "/pages/fpg-part-finder" },
    { "type": "text", "id": "service_url", "label": "Book a service page", "info": "The page with the FP&G service finder.", "default": "/collections/servicing-repair" },
    { "type": "text", "id": "contact_url", "label": "Contact page", "default": "/pages/contact" },
    { "type": "header", "content": "Part Finder app" },
    { "type": "paragraph", "content": "Saving to customers' accounts and their bought machines go through the FPG Part Finder app's proxy." },
    { "type": "text", "id": "proxy_prefix", "label": "Proxy prefix", "default": "apps" },
    { "type": "text", "id": "proxy_subpath", "label": "Proxy subpath", "default": "parts-finder" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "FP&G my machines" }]
}
{% endschema %}

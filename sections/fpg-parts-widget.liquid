{%- comment -%}
  FP&G front page parts finder widget (R-44). A way in to the real parts finder
  (sections/fpg-part-finder.liquid), not a second copy of it: brand tiles and
  model suggestions link straight to the finder page.

  Light on purpose: no finder scripts load here. assets/fpg-parts-index.json is
  only fetched when someone clicks into the search box, and without JavaScript
  the search box still works, sending the text to the finder as ?q=.
  Behaviour: assets/fpg-parts-widget.js. Styles: assets/fpg-parts-widget.css.
{%- endcomment -%}

{{ 'fpg-parts-widget.css' | asset_url | stylesheet_tag }}

{%- assign finder_url = section.settings.finder_url | default: '/pages/fpg-part-finder' -%}

<div class="section-background"></div>
<div
  class="section section--page-width spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <fpg-parts-widget
    class="fpg-pw"
    data-index="{{ 'fpg-parts-index.json' | asset_url }}"
    data-finder="{{ finder_url }}"
    data-hidden-brands="{{ section.settings.hidden_brands | escape }}"
  >
    <div class="fpg-pw__main">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fpg-pw__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="fpg-pw__h">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="fpg-pw__p">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <form class="fpg-pw__form" action="{{ finder_url }}" method="get" role="search" data-form>
        <label class="visually-hidden" for="FpgPw-{{ section.id }}">{{ section.settings.placeholder | escape }}</label>
        <svg class="fpg-pw__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input
          class="fpg-pw__input"
          id="FpgPw-{{ section.id }}"
          type="search"
          name="q"
          placeholder="{{ section.settings.placeholder | escape }}"
          autocomplete="off"
          spellcheck="false"
          aria-controls="FpgPwList-{{ section.id }}"
          aria-expanded="false"
          data-input
        >
        <button class="fpg-pw__submit" type="submit">{{ section.settings.button | escape }}</button>
        <ul class="fpg-pw__list" id="FpgPwList-{{ section.id }}" data-list hidden></ul>
      </form>

      <ol class="fpg-pw__steps" role="list" aria-label="How the parts finder works">
        <li>Choose the brand</li>
        <li>Pick the kind of machine</li>
        <li>Pick the model</li>
        <li>See every part, in sections</li>
      </ol>

      {%- if section.settings.extra_url != blank and section.settings.extra_label != blank -%}
        <p class="fpg-pw__extra">
          <a href="{{ section.settings.extra_url }}">{{ section.settings.extra_label | escape }}</a>
        </p>
      {%- endif -%}
    </div>

    <div class="fpg-pw__side">
      {%- if section.settings.brands_heading != blank -%}
        <p class="fpg-pw__side-h">{{ section.settings.brands_heading | escape }}</p>
      {%- endif -%}
      <ul class="fpg-pw__brands" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a class="fpg-pw__brand" href="{{ finder_url }}?brand={{ block.settings.brand_id }}" aria-label="{{ block.settings.name | escape }} parts">
              {%- if block.settings.logo != blank -%}
                {%- comment -%} Sharp on retina screens: the tiles are about 170px wide, so offer up to 600px. {%- endcomment -%}
                {{ block.settings.logo | image_url: width: 600 | image_tag: width: 300, height: 300, widths: '200, 300, 400, 600', sizes: '(min-width: 990px) 180px, (min-width: 750px) 22vw, 45vw', alt: block.settings.name, loading: 'lazy' }}
              {%- else -%}
                <span>{{ block.settings.name | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
        <li>
          <a class="fpg-pw__brand fpg-pw__brand--all" href="{{ finder_url }}">
            <span>{{ section.settings.all_label | escape }}</span>
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true" focusable="false"><path d="M4.5 10h11M15.5 10l-5-5M15.5 10l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </fpg-parts-widget>
</div>
<script src="{{ 'fpg-parts-widget.js' | asset_url }}" type="module" async></script>

{% schema %}
{
  "name": "FP&G parts finder widget",
  "tag": "section",
  "class": "fpg-pw-section",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 7,
  "settings": [
    { "type": "url", "id": "finder_url", "label": "Parts finder page" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Spare parts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right part for your machine" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Search your model, or pick the brand. Every part is listed in the section of the machine it belongs to." },
    { "type": "text", "id": "placeholder", "label": "Search box hint", "default": "Model or part number, e.g. MS 261" },
    { "type": "text", "id": "button", "label": "Search button", "default": "Find parts" },
    { "type": "text", "id": "brands_heading", "label": "Brands heading", "default": "Or start with the brand" },
    { "type": "text", "id": "all_label", "label": "All brands tile", "default": "All brands" },
    { "type": "text", "id": "extra_label", "label": "Extra link text" },
    { "type": "url", "id": "extra_url", "label": "Extra link" },
    { "type": "textarea", "id": "hidden_brands", "label": "Brands to leave out of the suggestions", "info": "One per line. Keep this the same as \"Brands to leave out\" on the parts finder page." },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name" },
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "number", "id": "brand_id", "label": "Brand number in the parts finder", "info": "The number after ?brand= on that brand's parts finder page." }
      ]
    }
  ],
  "presets": [{ "name": "FP&G parts finder widget" }]
}
{% endschema %}

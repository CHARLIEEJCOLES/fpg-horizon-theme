{%- comment -%}
  FP&G brand strip. Logos sit on matching white tiles at one height, shown in
  one tone until hovered, and scroll slowly (paused on hover, and still for
  anyone who prefers reduced motion). Each tile links to that brand's
  collection. Styles: assets/fpg-look.css.
{%- endcomment -%}

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--full-width spacing-style fpg-brands{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %} --fpg-brands-speed: {{ section.settings.speed }}s;"
>
  <header class="fpg-brands__head fpg-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fpg-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="h3">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </header>

  <div class="fpg-brands__viewport">
    {%- for pass in (1..2) -%}
      <ul class="fpg-brands__track" role="list" {% if pass == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          {%- if block.settings.logo != blank -%}
            <li {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
              <a
                class="fpg-brands__tile"
                href="{{ block.settings.link | default: '#' }}"
                {% if pass == 2 %}tabindex="-1"{% endif %}
              >
                {{
                  block.settings.logo
                  | image_url: width: 320
                  | image_tag:
                    loading: 'lazy',
                    widths: '160, 320',
                    sizes: '160px',
                    alt: block.settings.name,
                    class: 'fpg-brands__logo'
                }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "FP&G brands",
  "tag": "section",
  "class": "fpg-brands-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Approved dealer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brands we stock" },
    { "type": "range", "id": "speed", "label": "Scroll time for one loop", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 60 },
    { "type": "color", "id": "background_color", "label": "Background colour" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name" },
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "FP&G brands" }]
}
{% endschema %}

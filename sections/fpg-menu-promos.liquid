{%- comment -%}
  FP&G menu promos: picture cards shown on the right of the desktop menu
  dropdowns. Each "Promo" block names the top-level menu item it belongs to
  (matched on the item's title, ignoring capitals). The cards are kept in
  <template> tags here and placed into the dropdown by assets/fpg-design.js,
  so Horizon's own header files stay untouched. Lives in the footer group so
  it's on every page; it takes up no space itself.

  A "Parts panel" block is a larger card for the parts tools: a model search
  that opens the parts finder, the parts tools as one list, and a line for
  servicing. It can stand in for a menu column (e.g. "Find a Part") on
  desktop, so the same links aren't shown twice; phones keep the menu column.
{%- endcomment -%}

<div class="fpg-menu-promos" hidden>
  {%- for block in section.blocks -%}
    {%- liquid
      assign promo = block.settings
      assign menu_key = promo.menu_title | strip | downcase
    -%}
    {%- if menu_key != blank and block.type == 'parts_panel' -%}
      {%- assign finder_url = promo.finder_url | default: '/pages/fpg-part-finder' -%}
      <template
        data-fpg-menu-promo="{{ menu_key | escape }}"
        {{ block.shopify_attributes }}
      >
        <div
          class="fpg-menu-promo fpg-menu-promo--parts"
          {% if promo.replaces_column != blank %}
            data-fpg-replaces="{{ promo.replaces_column | strip | downcase | escape }}"
          {% endif %}
        >
          <div class="fpg-menu-parts">
            <div class="fpg-menu-parts__head">
              {%- if promo.eyebrow != blank -%}
                <span class="fpg-menu-promo__eyebrow">{{ promo.eyebrow | escape }}</span>
              {%- endif -%}
              {%- if promo.heading != blank -%}
                <span class="fpg-menu-parts__heading">{{ promo.heading | escape }}</span>
              {%- endif -%}
            </div>
            <form class="fpg-menu-parts__search" action="{{ finder_url }}" method="get" role="search">
              <label class="visually-hidden" for="FpgMenuParts-{{ block.id }}">{{ promo.placeholder | default: 'Your machine model' | escape }}</label>
              <input
                id="FpgMenuParts-{{ block.id }}"
                type="search"
                name="q"
                placeholder="{{ promo.placeholder | escape }}"
                autocomplete="off"
                spellcheck="false"
              >
              <button type="submit">{{ promo.button | default: 'Find parts' | escape }}</button>
            </form>
            <ul class="fpg-menu-parts__tools" role="list">
              {%- for i in (1..3) -%}
                {%- liquid
                  assign title_key = 'tool_' | append: i | append: '_title'
                  assign text_key = 'tool_' | append: i | append: '_text'
                  assign url_key = 'tool_' | append: i | append: '_url'
                  assign tool_title = promo[title_key]
                  assign tool_text = promo[text_key]
                  assign tool_url = promo[url_key]
                -%}
                {%- if tool_title != blank and tool_url != blank -%}
                  {%- liquid
                    assign external = false
                    if tool_url contains '://'
                      unless tool_url contains shop.domain or tool_url contains request.host
                        assign external = true
                      endunless
                    endif
                  -%}
                  <li>
                    <a
                      class="fpg-menu-parts__tool"
                      href="{{ tool_url }}"
                      {% if external %}
                        target="_blank" rel="noopener"
                      {% endif %}
                    >
                      <span class="fpg-menu-parts__icon" aria-hidden="true">
                        {%- case i -%}
                          {%- when 1 -%}
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><circle cx="15" cy="15" r="2"/><path d="M10.5 10.5l3 3M15 7h3M6 17h3"/></svg>
                          {%- when 2 -%}
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h12a4 4 0 0 1 0 8H4z"/><path d="M7 16h10" stroke-dasharray="1.5 2"/><path d="M4 8V4h6v4"/></svg>
                          {%- else -%}
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/><path d="M9.5 9a1.6 1.6 0 1 1 2.2 1.5c-.5.2-.7.6-.7 1.1M11 14h.01"/></svg>
                        {%- endcase -%}
                      </span>
                      <span class="fpg-menu-parts__tool-text">
                        <strong>{{ tool_title | escape }}</strong>
                        {%- if tool_text != blank -%}
                          <small>{{ tool_text | escape }}</small>
                        {%- endif -%}
                      </span>
                      <svg class="fpg-menu-parts__go" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {%- if promo.foot_label != blank and promo.foot_url != blank -%}
              <a class="fpg-menu-parts__foot" href="{{ promo.foot_url }}">
                {%- if promo.foot_text != blank -%}<span>{{ promo.foot_text | escape }}</span>{%- endif -%}
                <strong>{{ promo.foot_label | escape }}</strong>
              </a>
            {%- endif -%}
          </div>
        </div>
      </template>
    {%- elsif menu_key != blank -%}
      <template data-fpg-menu-promo="{{ menu_key | escape }}" {{ block.shopify_attributes }}>
        <div class="fpg-menu-promo">
          {%- if promo.link != blank -%}
            <a class="fpg-menu-promo__card" href="{{ promo.link }}">
          {%- else -%}
            <div class="fpg-menu-promo__card">
          {%- endif -%}
          {%- if promo.image != blank -%}
            <span class="fpg-menu-promo__media">
              {%- comment -%}
                The picture's address is parked in data- attributes so nothing can download it
                while the card waits in its <template>; fpg-design.js swaps it back when the card
                is placed in a desktop dropdown.
              {%- endcomment -%}
              {%- capture promo_image -%}
                {{
                  promo.image
                  | image_url: width: 640
                  | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '280px', alt: ''
                }}
              {%- endcapture -%}
              {{ promo_image | replace: ' src=', ' data-fpg-src=' | replace: ' srcset=', ' data-fpg-srcset=' }}
            </span>
          {%- endif -%}
          <span class="fpg-menu-promo__body">
            {%- if promo.eyebrow != blank -%}
              <span class="fpg-menu-promo__eyebrow">{{ promo.eyebrow | escape }}</span>
            {%- endif -%}
            {%- if promo.heading != blank -%}
              <span class="fpg-menu-promo__heading">{{ promo.heading | escape }}</span>
            {%- endif -%}
            {%- if promo.text != blank -%}
              <span class="fpg-menu-promo__text">{{ promo.text | escape }}</span>
            {%- endif -%}
            {%- if promo.label != blank and promo.link != blank -%}
              <span class="fpg-menu-promo__cta">
                {{ promo.label | escape }}
                <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- endif -%}
          </span>
          {%- if promo.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      </template>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
/* Parts panel: a wider card for the parts tools, standing in for the "Find a Part" column. */
[data-fpg-stood-in] {
  display: none !important;
}

@media screen and (min-width: 990px) {
  .menu-list__list-item:not([slot='overflow']) .mega-menu__grid:has(> .fpg-menu-promo--parts) {
    grid-template-columns: repeat(var(--menu-columns-desktop), minmax(0, 1fr)) minmax(320px, 400px);
  }
}

.fpg-menu-parts {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 20px;
  border-radius: 14px;
  background-color: var(--fpg-teal);
  background-image: radial-gradient(120% 90% at 100% 0%, rgb(95 125 109 / 0.5), transparent 60%);
  color: #fff;
  white-space: normal;
}

.fpg-menu-parts__head {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.fpg-menu-parts .fpg-menu-promo__eyebrow {
  color: #b9d3c4;
}

.fpg-menu-parts__heading {
  font-family: var(--font-heading--family);
  font-weight: var(--font-heading--weight);
  font-size: 1.3125rem;
  line-height: 1.2;
  color: #fff;
}

.fpg-menu-parts__search {
  display: flex;
  gap: 6px;
  padding: 4px;
  border-radius: 10px;
  background: #fff;
}

.fpg-menu-parts__search input {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 40px;
  padding: 0 10px;
  border: 0;
  background: none;
  font: inherit;
  font-size: 0.9375rem;
  color: var(--fpg-ink);
}

.fpg-menu-parts__search input:focus {
  outline: none;
}

.fpg-menu-parts__search:focus-within {
  box-shadow: 0 0 0 2px #8fb3a0;
}

.fpg-menu-parts__search button {
  flex: none;
  padding: 0 14px;
  border: 0;
  border-radius: 7px;
  background: var(--fpg-sage);
  color: #fff;
  font: inherit;
  font-size: 0.875rem;
  font-weight: 700;
  cursor: pointer;
}

.fpg-menu-parts__search button:hover {
  background: #4c6a5a;
}

.fpg-menu-parts__tools {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.fpg-menu-parts__tool {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) 16px;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgb(255 255 255 / 0.08);
  color: #fff;
  text-decoration: none;
  transition: background-color 0.2s var(--fpg-ease);
}

.fpg-menu-parts__tool:hover,
.fpg-menu-parts__tool:focus-visible {
  background: rgb(255 255 255 / 0.16);
}

.fpg-menu-parts__icon {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 9px;
  background: rgb(255 255 255 / 0.12);
  color: #b9d3c4;
}

.fpg-menu-parts__tool-text {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.fpg-menu-parts__tool-text strong {
  font-size: 0.9375rem;
  font-weight: 700;
  line-height: 1.25;
}

.fpg-menu-parts__tool-text small {
  font-size: 0.8125rem;
  line-height: 1.35;
  color: rgb(255 255 255 / 0.72);
}

.fpg-menu-parts__go {
  opacity: 0.6;
}

.fpg-menu-parts__foot {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 8px;
  padding-top: 12px;
  border-top: 1px solid rgb(255 255 255 / 0.16);
  font-size: 0.8125rem;
  color: rgb(255 255 255 / 0.78);
  text-decoration: none;
}

.fpg-menu-parts__foot strong {
  color: #fff;
  text-decoration: underline;
  text-underline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  .fpg-menu-parts__tool {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "FP&G menu promos",
  "class": "fpg-menu-promos-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "promo",
      "name": "Promo",
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Menu item title",
          "info": "The top-level menu item to show this under, e.g. Parts & Servicing"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "Find out more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "parts_panel",
      "name": "Parts panel",
      "settings": [
        { "type": "text", "id": "menu_title", "label": "Menu item title", "info": "The top-level menu item to show this under, e.g. Parts & Servicing", "default": "Parts & Servicing" },
        { "type": "text", "id": "replaces_column", "label": "Menu column it stands in for", "info": "On desktop this column is hidden while the panel shows, so its links aren't listed twice. Phones still show the column. Leave empty to keep it.", "default": "Find a Part" },
        { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Spare parts" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right part for your machine" },
        { "type": "url", "id": "finder_url", "label": "Parts finder page" },
        { "type": "text", "id": "placeholder", "label": "Search box hint", "default": "Your model, e.g. MS 261" },
        { "type": "text", "id": "button", "label": "Search button", "default": "Find parts" },
        { "type": "header", "content": "Parts tools" },
        { "type": "text", "id": "tool_1_title", "label": "Tool 1 title", "default": "Parts & diagrams by machine" },
        { "type": "text", "id": "tool_1_text", "label": "Tool 1 text" },
        { "type": "url", "id": "tool_1_url", "label": "Tool 1 link" },
        { "type": "text", "id": "tool_2_title", "label": "Tool 2 title", "default": "Common parts look up" },
        { "type": "text", "id": "tool_2_text", "label": "Tool 2 text" },
        { "type": "url", "id": "tool_2_url", "label": "Tool 2 link" },
        { "type": "text", "id": "tool_3_title", "label": "Tool 3 title", "default": "Parts ID request" },
        { "type": "text", "id": "tool_3_text", "label": "Tool 3 text" },
        { "type": "url", "id": "tool_3_url", "label": "Tool 3 link" },
        { "type": "header", "content": "Bottom line" },
        { "type": "text", "id": "foot_text", "label": "Text", "default": "Machine needs a service?" },
        { "type": "text", "id": "foot_label", "label": "Link label", "default": "Book a service" },
        { "type": "url", "id": "foot_url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FP&G menu promos"
    }
  ]
}
{% endschema %}
